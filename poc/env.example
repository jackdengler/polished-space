# Copy to poc/.env (gitignored) and fill in. Never commit a real key.
ANTHROPIC_API_KEY=

# Optional: fix the sandbox clock (ISO 8601). Used by seed, brain and mocks.
# POC_NOW=2026-11-13T09:00:00Z

# Optional: time zone for the sandbox's working day (IANA name). Use the same
# value when you run the seed so calendar times line up. Default: UTC.
# POC_TZ=UTC

# Optional: daily spend cap for Claude calls, in US dollars. Default: 5.
# POC_MAX_USD_PER_DAY=5
