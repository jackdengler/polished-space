# One image for pm, mocks and brain (plan section 3.2).
# Build context is the REPO ROOT (compose sets it), because pm-server imports
# Planr's own schema from src/model/schema.ts and serves the Planr build.
# No secrets are baked in: ANTHROPIC_API_KEY arrives at run time from poc/.env.
FROM node:22-bookworm-slim

WORKDIR /repo

# Planr (root) dependencies first, for layer caching.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# POC workspace dependencies. Each workspace's package.json is needed for npm ci.
COPY poc/package.json poc/package-lock.json poc/
COPY poc/packages/contracts/package.json poc/packages/contracts/
COPY poc/packages/pm-server/package.json poc/packages/pm-server/
COPY poc/packages/mocks/package.json poc/packages/mocks/
COPY poc/packages/brain/package.json poc/packages/brain/
COPY poc/packages/speech/package.json poc/packages/speech/
COPY poc/packages/sidebar/package.json poc/packages/sidebar/
COPY poc/seed/package.json poc/seed/
RUN npm --prefix poc ci --no-audit --no-fund

# Sources (see Dockerfile.node.dockerignore for what is left out; it excludes
# every dist/, so the Planr build is made here).
COPY . .

# The Planr test copy that pm-server serves from /repo/dist (repo-root Vite build).
RUN npx vite build \
 && test -f /repo/dist/index.html

ENV NODE_ENV=production \
    POC_DATA_DIR=/data
WORKDIR /repo/poc

# Each compose service sets its own command, e.g. `node --import tsx packages/mocks/src/server.ts`
# (node directly, not npm, so SIGTERM reaches the process for a clean stop).
CMD ["node", "-e", "console.log('set a command per service'); process.exit(1)"]
