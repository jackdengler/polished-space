# The gateway (plan section 3.1): nginx with the sidebar's static build baked
# in. Build context is the REPO ROOT (compose sets it). The sidebar is built
# here (dist/ is excluded from the build context), so the gateway never
# depends on a build made on the host.
#
#   docker compose -f poc/docker-compose.yml build gateway
FROM node:22-bookworm-slim AS sidebar
WORKDIR /repo/poc
# npm needs every workspace's package.json to read the lockfile.
COPY poc/package.json poc/package-lock.json poc/tsconfig.base.json ./
COPY poc/packages/contracts/package.json packages/contracts/
COPY poc/packages/pm-server/package.json packages/pm-server/
COPY poc/packages/mocks/package.json packages/mocks/
COPY poc/packages/brain/package.json packages/brain/
COPY poc/packages/speech/package.json packages/speech/
COPY poc/packages/sidebar/package.json packages/sidebar/
COPY poc/seed/package.json seed/
RUN npm ci --no-audit --no-fund -w @poc/sidebar -w @poc/contracts --include-workspace-root
COPY poc/packages/contracts packages/contracts
COPY poc/packages/sidebar packages/sidebar
RUN cd packages/sidebar && npx vite build \
 && grep -q '<script type="module"' dist/index.html

FROM nginx:1.27-alpine
COPY poc/gateway/nginx.conf /etc/nginx/nginx.conf
COPY --from=sidebar /repo/poc/packages/sidebar/dist /usr/share/nginx/html
