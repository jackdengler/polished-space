{
  "name": "@poc/sidebar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The assistant sidebar: living task list, nudges, approvals, chat and live voice. React 19 + Vite + zustand.",
  "scripts": {
    "dev": "tsx fixture/server.ts --port 5190 --dev",
    "build": "vite build",
    "fixture": "vite build && tsx fixture/server.ts --port 5190 --static dist",
    "start": "vite build && tsx fixture/server.ts --port 5190 --static dist",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "e2e": "vite build && node e2e/walkthrough.mjs"
  },
  "dependencies": {
    "@poc/contracts": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "playwright": "1.63.0",
    "vite": "^8.3.6",
    "ws": "^8.23.0"
  }
}
