{
  "name": "planr-poc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "AI Work Assistant proof of concept. Sandbox only: invented data, no real systems.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/contracts",
    "packages/pm-server",
    "packages/mocks",
    "packages/brain",
    "packages/speech",
    "packages/sidebar",
    "seed"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "seed": "npm run seed -w @poc/seed --",
    "dev:up": "node scripts/dev.mjs up",
    "dev:reset": "node scripts/dev.mjs reset",
    "dev:down": "node scripts/dev.mjs down",
    "up": "node scripts/compose.mjs up",
    "reset": "node scripts/compose.mjs reset",
    "down": "node scripts/compose.mjs down",
    "check:isolation": "sh scripts/check-isolation.sh",
    "check:secrets": "node scripts/check-secrets.mjs",
    "e2e": "node e2e/demo.mjs",
    "e2e:live": "POC_E2E_LIVE=1 node e2e/demo.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^5.1.0"
  }
}
