# Speech service (plan sections 3.1 and 6): local streaming speech-to-text,
# voice activity detection and text-to-speech on sherpa-onnx.
#
# Build context is the REPO ROOT (compose sets it). The models are downloaded
# HERE, at build time (needs internet: github.com and
# release-assets.githubusercontent.com), and baked into the image, so the
# container needs no network at run time. Each model download is pinned by
# SHA-256 in poc/packages/speech/src/models.ts.
#
#   docker compose -f poc/docker-compose.yml build speech
#   docker build -f poc/Dockerfile.speech --build-arg TTS_VOICES=cori,ljspeech .   # extra voice
FROM node:22-bookworm-slim

# curl + bzip2 for the model download script (tar is already in the image).
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl bzip2 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /repo/poc

# Dependencies of @poc/speech only (plus the workspace root's tsx). npm needs
# every workspace's package.json to read the lockfile.
COPY poc/package.json poc/package-lock.json poc/tsconfig.base.json ./
COPY poc/packages/contracts/package.json packages/contracts/
COPY poc/packages/pm-server/package.json packages/pm-server/
COPY poc/packages/mocks/package.json packages/mocks/
COPY poc/packages/brain/package.json packages/brain/
COPY poc/packages/speech/package.json packages/speech/
COPY poc/packages/sidebar/package.json packages/sidebar/
COPY poc/seed/package.json seed/
RUN npm ci --no-audit --no-fund -w @poc/speech --include-workspace-root

# Models: a separate layer that only re-runs when the manifest or script changes.
ARG TTS_VOICES=cori
COPY poc/packages/speech/src/models.ts packages/speech/src/models.ts
COPY poc/packages/speech/scripts/download-models.ts packages/speech/scripts/download-models.ts
RUN npm run models -w @poc/speech -- --voices "$TTS_VOICES" \
 && chmod -R a+rX packages/speech/models

# Sources (models/ and node_modules/ are excluded by Dockerfile.speech.dockerignore).
COPY poc/packages/contracts packages/contracts
COPY poc/packages/speech packages/speech

ENV NODE_ENV=production \
    SPEECH_MODELS_DIR=/repo/poc/packages/speech/models \
    SPEECH_PORT=7100 \
    SPEECH_HOST=0.0.0.0

USER node
EXPOSE 7100
# Model loading takes a few seconds on start.
HEALTHCHECK --interval=10s --timeout=3s --start-period=60s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:7100/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]

# node directly (not npm) so SIGTERM reaches the server for a clean stop.
CMD ["node", "--import", "tsx", "packages/speech/src/main.ts"]
